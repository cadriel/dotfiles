[user]
  name = Craig Bassett
  email = {{ .email }}
[color]
  ui = true
[push]
  default = current
[commit]
  gpgSign = false
[pull]
  rebase = true
[init]
  defaultBranch = main
[alias]
  c = commit -s
[credential "https://github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
  useHttpPath = true
[credential "https://gist.github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
# Work identity and credentials (encrypted, skipped if absent)
[include]
  path = config.work
# Repos cloned via the personal SSH alias commit as the personal identity
[includeIf "hasconfig:remote.*.url:git@github.com-personal:*/**"]
  path = config.personal
